{"version": 1, "default": "deny", "rules": [{"id": "read-source", "effect": "allow", "kind": "path", "actions": ["read"], "paths": ["src/**", "README.md"]}, {"id": "safe-tests", "effect": "allow", "kind": "command", "actions": ["run"], "commands": ["pytest"], "argv_patterns": [["pytest", "-q"]]}, {"id": "deny-secrets", "effect": "deny", "kind": "path", "actions": ["read", "write"], "paths": [".env", ".env.*", "secrets/**"], "reason": "credential material is not in scope"}, {"id": "git-readonly", "effect": "allow", "kind": "git", "actions": ["status", "diff"], "repositories": ["."]}, {"id": "public-docs", "effect": "allow", "kind": "network", "actions": ["connect"], "hosts": ["docs.python.org"], "ports": [443], "protocols": ["tcp"]}, {"id": "read-build-env", "effect": "allow", "kind": "env", "actions": ["read"], "names": ["PYTHONPATH"]}]}
