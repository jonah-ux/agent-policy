{
  "schema": "agent-systems-lab-policy-conformance/v1",
  "owner": "agent-policy",
  "native_schema": "agent-policy/v1",
  "shared_adapter": {
    "owner": "agent-proof",
    "schema": "agent-proof/interop/v1",
    "manifest_url": "https://github.com/jonah-ux/agent-proof/blob/283a5e69db44d43f87876b4b30b576a0dcac7930/conformance/agent-systems-lab.json",
    "revision": "283a5e69db44d43f87876b4b30b576a0dcac7930"
  },
  "cases": [
    {"name": "explicit-allow", "decision": "allow", "source": "explicit_allow"},
    {"name": "explicit-deny", "decision": "deny", "source": "explicit_deny"},
    {"name": "default-deny", "decision": "deny", "source": "default_deny"},
    {"name": "path-traversal", "valid": false, "mutation": "request.path"},
    {"name": "unknown-policy-version", "valid": false, "mutation": "policy.version"}
  ],
  "privacy": {
    "receipt_fields": ["decision", "decision_source", "policy.sha256", "request.sha256", "rule_count", "operation_count"],
    "raw_policy_values_exported": false,
    "request_targets_summarized": true
  }
